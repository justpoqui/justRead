{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The reading UI. Gets the library commands, the open-file dialog and basic window/event access \u2014 nothing else (no fs, shell, http or opener plugins).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:app:allow-exit",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:webview:default",
    "dialog:allow-open",
    "allow-supported-extensions",
    "allow-list-books",
    "allow-get-book",
    "allow-import-books",
    "allow-delete-book",
    "allow-open-book",
    "allow-read-chapter",
    "allow-save-progress",
    "allow-set-cover",
    "allow-get-setting",
    "allow-set-setting",
    "allow-list-annotations",
    "allow-add-annotation",
    "allow-update-annotation",
    "allow-delete-annotation",
    "allow-export-annotations",
    "allow-share-annotations",
    "allow-save-annotations",
    "allow-set-book-status",
    "allow-list-collections",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-delete-collection",
    "allow-set-in-collection",
    "allow-record-reading",
    "allow-reading-stats",
    "allow-book-stats",
    "allow-set-screen",
    "allow-check-update",
    "allow-install-update",
    "allow-open-browser",
    "allow-take-pending-open"
  ]
}
