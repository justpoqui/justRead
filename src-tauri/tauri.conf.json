{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "justRead",
  "version": "0.2.0",
  "identifier": "app.justread.reader",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "justRead",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' justbook: http://justbook.localhost",
        "img-src": "'self' justbook: http://justbook.localhost data: blob:",
        "font-src": "'self' justbook: http://justbook.localhost data:",
        "connect-src": "'self' ipc: http://ipc.localhost justbook: http://justbook.localhost",
        "base-uri": "'self' justbook: http://justbook.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "form-action": "'none'",
        "worker-src": "'self' blob:"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "category": "Education",
    "shortDescription": "An offline, privacy-respecting ebook reader.",
    "longDescription": "justRead is an open-source ebook reader. All data stays on your device: no accounts, no cloud, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "mobi",
          "azw",
          "prc"
        ],
        "name": "Mobipocket book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "azw3"
        ],
        "name": "Kindle book (KF8)",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.amazon.mobi8-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic book (ZIP)",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "cb7"
        ],
        "name": "Comic book (7-Zip)",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-cb7"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ]
  }
}
